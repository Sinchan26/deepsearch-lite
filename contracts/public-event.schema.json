        "research_requests": {
          "default": 0,
          "minimum": 0,
          "title": "Research Requests",
          "type": "integer"
        },
        "revisions": {
          "default": 0,
          "minimum": 0,
          "title": "Revisions",
          "type": "integer"
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        }
      },
      "required": [
        "limits"
      ],
      "title": "Budget",
      "type": "object"
    },
    "BudgetEvent": {
      "additionalProperties": false,
      "properties": {
        "payload": {
          "$ref": "#/$defs/Budget"
