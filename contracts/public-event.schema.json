          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "seq": {
          "exclusiveMinimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
