      "critique.feedback": "#/$defs/CritiqueEvent",
      "draft.available": "#/$defs/DraftEvent",
      "evidence.added": "#/$defs/EvidenceEvent",
      "plan.summary": "#/$defs/SummaryEvent",
      "research.action": "#/$defs/SummaryEvent",
      "revision.started": "#/$defs/RevisionEvent",
      "run.started": "#/$defs/StartedEvent",
      "run.terminal": "#/$defs/TerminalEvent",
      "search.activity": "#/$defs/SearchEvent"
