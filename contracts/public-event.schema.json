        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "seq": {
          "exclusiveMinimum": 0,
