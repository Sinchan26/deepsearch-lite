    "clsx": "^2.1.1", "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0", "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0", "vite": "^7.0.0", "vitest": "^4.0.0",
    "@vitejs/plugin-react": "^5.0.0", "tailwindcss": "^4.0.0", "@tailwindcss/vite": "^4.0.0",
    "json-schema-to-typescript": "^15.0.0"
